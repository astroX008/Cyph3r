enum Cifrados {cesar2 = 1,morse2,traspo2,a1z26_2,atbash2,atras2};

// Funcion para cifrar texto a A1Z26
string cifrarA1Z26(const string& txt) {
    string result = "";
    for (size_t i = 0; i < txt.length(); ++i) {
        char c = txt[i];
        if (isalpha(c)) {
            char base = isupper(c) ? 'A' : 'a';
            int num = (c - base) + 1;
            result += to_string(num) + " ";
        } else if (isdigit(c)) {
            result += "[num:" + string(1, c) + "] ";
        } else {
            result += c;
            if (c != ' ') {
                result += " ";
            }
        }
    }
    return result;
}

// Funcion para descifrar A1Z26 a texto
string descifrarA1Z26(const string& code) {
    string result = "";
    stringstream ss(code);
    string token;

    while (ss >> token) {
        if (token.rfind("[num:", 0) == 0) {
            char dig = token[5];
            result += dig;
        } else {
            bool esNum = true;
            for (char c : token) {
                if (!isdigit(c)) {
                    esNum = false;
                    break;
                }
            }

            if (esNum) {
                int num = stoi(token);
                if (num >= 1 && num <= 26) {
                    result += (char)('A' + num - 1);
                } else {
                    result += token;
                }
            } else {
                result += token;
            }
        }
    }
    return result;
}

